# ─── Python bytecode & caches ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ─── Virtual environments ────────────────────────────────────────────────────
venv/
env/
.venv/
.env/

# ─── Jupyter / IPython ──────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Raw biomechanical data (large binary; hosted on Zenodo) ────────────────
data/raw/
data/opensim_processed/
scratch/

# ─── Pre-computed processed cache (large .npz / .npy / .pkl) ────────────────
data/processed/*.npz
data/processed/*.npy
data/processed/*.pkl

# ─── Trained model checkpoints (PyTorch .pt files) ──────────────────────────
experiments/
New_experiments/

# ─── Paper manuscript, figures, and compilers (local only, do not upload) ──
paper/

# ─── Internal planning & agent workspace files (local only) ──────────────────
architecture.md
design.md
memory.md
phases.md
prd.md
rules.md
task.md

# ─── Scratch / temporary scripts ─────────────────────────────────────────────
scratch/

